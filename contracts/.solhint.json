{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": ["error", "0.8.36"],
    "func-visibility": ["error", { "ignoreConstructors": true }],
    "import-path-check": "off",
    "gas-custom-errors": "error",
    "use-natspec": [
      "error",
      {
        "title": { "enabled": false },
        "author": { "enabled": false },
        "notice": { "enabled": true },
        "param": { "enabled": false },
        "return": { "enabled": false }
      }
    ]
  }
}
